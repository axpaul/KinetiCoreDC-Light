		(uuid "3500400c-db65-4e28-90a1-c70786e863c3")
	)
	(text_box "• Specs: 15 A cont. (30 A peak) | Gold-plated (< 0.8 mΩ)\n• Keying & Fit: Polarized keyed | Low-profile right-angle mount\n• Interface: Anti-vibration friction lock | 1S-3S LiPo standard"
		(exclude_from_sim no)
		(at 16.51 104.14 0)
		(size 76.2 8.0376)
		(margins 0.9525 0.9525 0.9525 0.9525)
